# Copy to .env and fill in. Read by docker-compose.yml at the repo root.

# Postgres, started by the `postgres` service.
POSTGRES_USER=snap
POSTGRES_PASSWORD=
POSTGRES_DB=snap

# RabbitMQ, started by the `rabbitmq` service.
RABBITMQ_USER=snap
RABBITMQ_PASSWORD=

# Number of pm2 cluster instances the backend service runs. Change this
# instead of the code to scale up or down.
BACKEND_INSTANCES=3
