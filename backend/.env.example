# Copy to .env and fill in. Bun loads .env automatically — no dotenv needed.
# Every one of these is read at startup and throws if missing, so the server
# will not boot until all seven are set.

# Two shards — see src/db/shards.ts (UPPGIFT.md punkt 7 / architecture.png's
# "DB Router"). `docker compose up -d` (from the snap-fullstack root) starts
# matching instances, with credentials from the root .env (POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB) — match those here, then run
# `bunx dbmate up` against EACH shard's DATABASE_URL in turn.
# Not needed when the backend itself runs via that same docker-compose.yml:
# it sets both for you there, pointed at the postgres-a/postgres-b services.
DATABASE_URL_A=postgres://user:password@localhost:5432/snap
DATABASE_URL_B=postgres://user:password@localhost:5433/snap

# Signs and verifies both access and refresh tokens (src/auth.ts).
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# S3, for photo snaps. Names mirror Bun's S3Client options (src/utils/s3.ts).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
